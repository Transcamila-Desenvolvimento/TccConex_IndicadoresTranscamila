# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# PostgreSQL (produção — omitir para SQLite local)
# USE_POSTGRES=True
# DB_NAME=prothon_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Celery + Redis (importações assíncronas)
# USE_CELERY=True
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Presença online (WebSocket) — usa Redis se USE_CELERY=True; senão memória local (dev)
# USE_PRESENCE_REDIS=auto
# PRESENCE_REDIS_URL=redis://localhost:6379/0

# E-mail SMTP (gerencial, marketing, etc.)
# Dev sem SMTP: omitir EMAIL_BACKEND ou usar console
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=digitalmidia@transcamila.com.br
EMAIL_HOST_PASSWORD=sua-senha-de-app-gmail
DEFAULT_FROM_EMAIL=digitalmidia@transcamila.com.br
FRONTEND_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8001

# Google OAuth (vincular conta @transcamila.com.br — contatos e Drive pessoal)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback
# GOOGLE_OAUTH_HD=transcamila.com.br

# Google Maps (cotação: distância, autocomplete e mapa)
# Sem esta chave o sistema usa OpenStreetMap. Para o mapa na cotação, habilite
# também Maps JavaScript API e Places API na mesma chave
# (além de Geocoding e Distance Matrix), para mapa e busca por nome de empresa.
# GOOGLE_MAPS_API_KEY=

# Google Chat (avisos do sino também enviados por mensagem direta do app "TccConex ERP")
# Conteúdo JSON da chave da conta de serviço (ou caminho do arquivo). Vazio = só o sino no ERP.
# GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=

# Web Push (avisos no canto do Windows/navegador). Par VAPID gerado uma vez (base64url):
# pública = ponto P-256 não comprimido; privada = 32 bytes. Sem as duas, só o sininho.
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_SUBJECT=mailto:digitalmidia@transcamila.com.br

# Reciclagem dos avisos (roda sozinha 1x por intervalo; manual: manage.py reciclar_notificacoes)
# NOTIFICACOES_RETER_LIDAS_DIAS=30
# NOTIFICACOES_RETER_DIAS=90
# NOTIFICACOES_MAX_POR_USUARIO=200
# NOTIFICACOES_PUSH_RETER_DIAS=90
# NOTIFICACOES_RECICLAGEM_INTERVALO_HORAS=24
